# ---------------------------------------------------------------------------
# Variables d'environnement — Déploiement Railway (E-Intendance LISI)
# ---------------------------------------------------------------------------
# À renseigner dans : Railway → service de l'app → onglet "Variables".
# Ne PAS committer de vraies valeurs : ce fichier est un modèle.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="E-Intendance LISI"
APP_ENV=production
# Générer en local avec :  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# URL publique fournie par Railway (onglet Settings → Domains)
APP_URL=https://votre-app.up.railway.app

# --- Base de données (service MySQL Railway) ---
DB_CONNECTION=mysql
# Utiliser les "reference variables" du plugin MySQL de Railway :
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# --- Sessions / Cache / Queue ---
# Stockés en base : aucune dépendance Redis, survivent au redéploiement.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# NB : Laravel 11 a renommé ces clés. Railway lit les deux noms sans risque,
# mais ce sont CACHE_STORE / QUEUE_CONNECTION qui sont effectivement utilisées.
CACHE_DRIVER=database
CACHE_STORE=database
QUEUE_DRIVER=database
QUEUE_CONNECTION=database

# --- Divers ---
LOG_CHANNEL=stack
LOG_LEVEL=error
BCRYPT_ROUNDS=12
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Mail : par défaut "log" (les mails partent dans les logs).
# Renseigner un SMTP réel pour l'envoi effectif (reset de mot de passe, notifications).
MAIL_MAILER=log
